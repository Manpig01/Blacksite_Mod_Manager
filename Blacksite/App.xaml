<Application x:Class="Blacksite.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Blacksite.Converters"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Dark.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility"/>
      <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
      <conv:CountToVisibilityConverter x:Key="CountToVisibility"/>
      <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
