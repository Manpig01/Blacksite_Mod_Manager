<Window x:Class="Blacksite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="Blacksite Mod Manager - BETA v1.9.0"
        Height="920" Width="1500" MinHeight="640" MinWidth="1080"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <!-- Borderless window with working edge-resize and no native captions. -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ============================================================ Custom titlebar (WindowStyle=None) -->
    <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Height="42"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="Assets/emblem.png" Width="22" Height="22" VerticalAlignment="Center"
                 Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"
                 ToolTip="Blacksite Mod Manager"/>
          <TextBlock Text="Blacksite Mod Manager - BETA v1.9.0" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleBarButton}" Content="—" Width="46"
                  Click="OnMinimizeClick" ToolTip="Minimize"/>
          <Button Style="{StaticResource TitleBarButton}" Content="□" Width="46"
                  Click="OnMaximizeRestoreClick" ToolTip="Maximize / Restore"/>
          <Button Style="{StaticResource TitleBarCloseButton}" Content="✕" Width="46"
                  Click="OnCloseClick" ToolTip="Close"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ Header -->
    <Border Grid.Row="1" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
            Padding="18,12,18,0">
      <StackPanel>

        <!-- Title row -->
        <Grid Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="🐉" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Blacksite" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text=" Mod Manager" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,1,0,0"/>
            <Border Background="{StaticResource BgSurface}" CornerRadius="4" Padding="7,2" Margin="12,2,0,0" VerticalAlignment="Center">
              <TextBlock Text="SPT · sp-mod.com" FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Global controls row -->
        <Grid Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                  Content="📁  Set SPT Directory" Command="{Binding SetDirectoryCommand}"
                  ToolTip="Choose the Single Player Tarkov root folder (the one containing BepInEx and user)"/>

          <Border Grid.Column="2" Background="{StaticResource BgInput}" CornerRadius="6"
                  BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="10,7"
                  ToolTip="{Binding SptDirectoryDisplay}" MinWidth="160">
            <TextBlock Text="{Binding SptDirectoryDisplay}" Foreground="{StaticResource TextSecondary}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </Border>

          <TextBlock Grid.Column="4" Text="SPT Version" VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondary}"
                     ToolTip="Used to resolve compatible versions, dependencies and updates. Auto-detected when possible."/>
          <TextBox Grid.Column="6" Width="86" VerticalAlignment="Center"
                   Text="{Binding SptVersion, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Your installed SPT version, e.g. 4.0.12"/>

          <Button Grid.Column="8" Style="{StaticResource GreenButton}" Content="🚀  Launch SPT"
                  Command="{Binding LaunchSptCommand}"
                  ToolTip="Start the SPT server, watch its console until it is ready, then launch the game launcher"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ============================================================ Tabs -->
    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex}" Margin="10,6,10,0" Background="Transparent">

      <!-- ==================== Browse Mods ==================== -->
      <TabItem Header="Browse Mods">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- ==================== Filter Panel ==================== -->
          <Border Grid.Row="0" Margin="4,8,4,2" Background="{StaticResource BgPanel}"
                  BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <StackPanel>
                <!-- Row 1: search · Clear · Refresh · counter · content toggles -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <!-- Real-time text search → live API query parameter (query=…) after a 300 ms debounce -->
                  <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBox Padding="30,7,8,7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="🔍" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Search mods or type @Author..." Margin="31,0,8,0"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding SearchText}" Value="">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>

                  <Button Grid.Column="2" Style="{StaticResource DarkButton}" Content="Clear"
                          Command="{Binding ClearCatalogFiltersCommand}" MinWidth="84"
                          ToolTip="Reset all filters and sorting parameters back to their default states"/>
                  <Button Grid.Column="4" Style="{StaticResource DarkButton}" Content="Refresh"
                          Command="{Binding RefreshCommand}" MinWidth="92"
                          ToolTip="Re-run the current catalog query against the sp-mod.com API"/>

                  <TextBlock Grid.Column="6" Text="{Binding ShowingText}" VerticalAlignment="Center"
                             FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                             ToolTip="Cards visible on the current page vs. total matching mods"/>

                  <CheckBox Grid.Column="8" VerticalAlignment="Center" Content="Hide Featured"
                            IsChecked="{Binding HideFeatured}"
                            ToolTip="Hide mods flagged as featured on sp-mod.com"/>
                  <CheckBox Grid.Column="10" VerticalAlignment="Center" Content="Hide Contains Ads"
                            IsChecked="{Binding HideContainsAds}"
                            ToolTip="Hide mods that contain advertisements"/>
                </Grid>

                <!-- Row 2: dropdowns · toggles · pagination -->
                <Grid Margin="0,9,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <ComboBox Grid.Column="0" Width="200"
                            ItemsSource="{Binding SptVersionOptions}"
                            SelectedItem="{Binding SelectedSptVersionOption}"
                            ToolTip="Only show mods compatible with the selected SPT release (server-side filter[spt_version])"/>
                  <ComboBox Grid.Column="2" Width="170"
                            ItemsSource="{Binding CategoryOptions}"
                            SelectedItem="{Binding SelectedCategoryOption}"
                            ToolTip="Populated live from GET /mod-categories — server-side filter[category_id]"/>
                  <ComboBox Grid.Column="4" Width="190"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption}"
                            ToolTip="Changes the order of the returned dataset — Most Downloaded (sort=-downloads), Most Recent (sort=-published_at), Alphabetical (sort=name)…"/>
                  <ComboBox Grid.Column="6" Width="72"
                            ItemsSource="{Binding PerPageOptions}"
                            SelectedItem="{Binding PerPage}"
                            ToolTip="Cards per page"/>

                  <CheckBox Grid.Column="8" VerticalAlignment="Center" Content="Hide Contains AI"
                            IsChecked="{Binding HideContainsAi}"
                            ToolTip="Hide mods that contain AI-generated content"/>
                  <CheckBox Grid.Column="10" VerticalAlignment="Center" Content="Hide Installed"
                            IsChecked="{Binding HideInstalledMods}"
                            ToolTip="Hide mods you already installed through Blacksite"/>
                  <CheckBox Grid.Column="12" VerticalAlignment="Center" Content="Fika Comp Only"
                            IsChecked="{Binding FikaOnly}"
                            ToolTip="Only show mods explicitly marked fika_compatibility = true (server-side filter[fika_compatibility]=1)"/>

                  <Button Grid.Column="14" Style="{StaticResource DarkButton}" Content="◄  Prev" MinWidth="78"
                          Command="{Binding PrevPageCommand}" Padding="10,6"
                          ToolTip="Previous page"/>
                  <TextBlock Grid.Column="16" Text="{Binding PageText}" VerticalAlignment="Center"
                             FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                  <Button Grid.Column="18" Style="{StaticResource DarkButton}" Content="Next  ►" MinWidth="78"
                          Command="{Binding NextPageCommand}" Padding="10,6"
                          ToolTip="Next page"/>

                  <Button Grid.Column="20" Style="{StaticResource DarkButton}" Content="📂  Install from file…"
                          Command="{Binding InstallLocalCommand}"
                          ToolTip="Install a mod from a local .zip / .rar / .7z archive on your disk — extracted into your SPT folder with live progress"/>
                </Grid>

            </StackPanel>
          </Border>

          <!-- Catalog grid -->
          <Grid Grid.Row="1" Margin="0,6,0,0">
            <ListBox x:Name="CardsList"
                     ItemsSource="{Binding Items}"
                     SizeChanged="OnCardsListSizeChanged"
                     Padding="4,6,4,10"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <wpf:VirtualizingWrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>

              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- ============================ Mod card (3-column grid, compact 220px, 135px thumbnail) ============================ -->
                  <Border Height="220" Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                          Margin="6" Padding="12" CornerRadius="8"
                          Background="{StaticResource BgCard}" BorderThickness="1"
                          Loaded="Card_Loaded">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <!-- Thumbnail block: large 1:1 square, rounded, badges overlaid -->
                      <Grid Grid.Column="0" Width="135" Height="135" VerticalAlignment="Center">
                        <Border Background="{StaticResource BgSurface}" CornerRadius="6" ClipToBounds="True">
                          <TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="Bold"
                                     Foreground="#3A4150" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Image with a null Source renders nothing, so the placeholder shows until loaded -->
                        <Image Source="{Binding Thumbnail}" Width="135" Height="135"
                               Stretch="UniformToFill" ClipToBounds="True"
                               RenderOptions.BitmapScalingMode="HighQuality">
                          <Image.Clip>
                            <RectangleGeometry Rect="0,0,135,135" RadiusX="6" RadiusY="6"/>
                          </Image.Clip>
                        </Image>

                        <!-- Top-left: green SPT-version pill -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="{StaticResource Green}" CornerRadius="6" Padding="6,2" Margin="3">
                          <TextBlock Text="{Binding SptBadgeText}" FontSize="9.5" FontWeight="SemiBold"
                                     Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="126"
                                     Visibility="{Binding HasSptBadge, Converter={StaticResource BoolToVisibility}}"/>
                        </Border>

                        <!-- Bottom-left: Fika Compatible overlay -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Background="#0E2A18" BorderBrush="{StaticResource Green}" BorderThickness="1"
                                CornerRadius="6" Padding="6,2" Margin="3">
                          <TextBlock Text="Fika Compatible" FontSize="9.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource GreenHover}"
                                     Visibility="{Binding ShowFikaOverlay, Converter={StaticResource BoolToVisibility}}"/>
                        </Border>
                      </Grid>

                      <!-- Content area (right of the thumbnail) -->
                      <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}"/>

                        <!-- Package id -->
                        <TextBlock Grid.Row="1" Text="{Binding PackageId}" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageId}"/>

                        <!-- Author pill (orange) + category pills (gray) -->
                        <WrapPanel Grid.Row="2" Margin="0,6,0,0" MaxHeight="48">
                          <Border Background="#3A2415" BorderBrush="{StaticResource Accent}"
                                  BorderThickness="1" CornerRadius="9" Padding="9,2" Margin="0,0,5,3">
                            <TextBlock Text="{Binding AuthorPillText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentHover}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="150" ToolTip="{Binding Author}"/>
                          </Border>
                          <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                                  BorderThickness="1" CornerRadius="9" Padding="9,2" Margin="0,0,5,3"
                                  Visibility="{Binding HasCategory, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PrimaryTagText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                          </Border>
                          <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                                  BorderThickness="1" CornerRadius="9" Padding="9,2" Margin="0,0,5,3"
                                  Visibility="{Binding HasSecondaryTag, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SecondaryTagText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                          </Border>
                        </WrapPanel>

                        <!-- Metadata row -->
                        <TextBlock Grid.Row="3" Text="{Binding StatsText}" FontSize="11.5" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding StatsText}"/>

                        <!-- Description: exactly 2 lines with word-ellipsis. (WPF TextBlock has no
                             WinUI-style MaxLines property — LineHeight x2 + MaxHeight is the exact equivalent.) -->
                        <TextBlock Grid.Row="4" Text="{Binding Teaser}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                   LineHeight="14" MaxHeight="28" TextTrimming="WordEllipsis" VerticalAlignment="Top"
                                   ToolTip="{Binding Teaser}"/>

                        <!-- Action row -->
                        <Grid Grid.Row="5" Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="{Binding InstalledBadgeText}" FontSize="11"
                                     Foreground="{StaticResource Green}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"/>

                          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="🕘" FontSize="12" Padding="6,0"
                                    Height="28" Command="{Binding VersionsCommand}"
                                    ToolTip="Pick a specific release — full version list with changelogs"/>
                            <Button Style="{StaticResource DarkButton}" Content="Mod Page" Height="28" MinWidth="88"
                                    Padding="10,0" Margin="6,0,0,0" Command="{Binding OpenPageCommand}"
                                    ToolTip="Open the mod page on sp-mod.com"
                                    Visibility="{Binding HasDetailUrl, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Style="{StaticResource GreenButton}" Height="28" MinWidth="104"
                                    Padding="10,0" Margin="8,0,0,0"
                                    Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}"
                                    ToolTip="Download the latest compatible release and extract it into your SPT folder"/>
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
              <TextBlock Text="🐉" FontSize="44" HorizontalAlignment="Center" Opacity="0.55"/>
              <TextBlock Text="{Binding EmptyStateText}" FontSize="15" Margin="0,10,0,0"
                         Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ==================== Installed Mods ==================== -->
      <TabItem Header="{Binding InstalledTabHeader}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Installed action bar -->
          <Grid Grid.Row="0" Margin="4,10,4,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource DarkButton}" Content="Refresh" MinWidth="92"
                    Command="{Binding RescanCommand}"
                    ToolTip="Re-scan user\mods and BepInEx\plugins for installed mods"/>
            <Button Grid.Column="2" Style="{StaticResource GreenButton}" Content="Enable All" MinWidth="100"
                    Command="{Binding EnableAllCommand}"
                    ToolTip="Re-enable every disabled mod (removes the .disabled folder suffix)"/>
            <Button Grid.Column="4" Style="{StaticResource RedButton}" Content="Disable All" MinWidth="100"
                    Command="{Binding DisableAllCommand}"
                    ToolTip="Disable every mod (renames its folder with a .disabled suffix so SPT skips it)"/>
            <Button Grid.Column="6" Style="{StaticResource DarkButton}" Content="Client Folder" MinWidth="110"
                    Command="{Binding OpenClientFolderCommand}"
                    ToolTip="Open the client mods folder (BepInEx\plugins) in Windows Explorer"/>
            <Button Grid.Column="8" Style="{StaticResource DarkButton}" Content="Server Folder" MinWidth="110"
                    Command="{Binding OpenServerFolderCommand}"
                    ToolTip="Open the server mods folder (user\mods) in Windows Explorer"/>
            <Button Grid.Column="10" Style="{StaticResource RedButton}" Content="Uninstall All" MinWidth="106"
                    Command="{Binding UninstallAllCommand}"
                    ToolTip="Permanently delete ALL installed mods from your SPT folder (asks for confirmation)"/>

            <Button Grid.Column="12" Style="{StaticResource AccentButton}" Content="🔄  Check for Updates"
                    Command="{Binding CheckUpdatesCommand}"
                    ToolTip="Send the installed package IDs + versions to the sp-mod.com update API (GET /mods/updates)"/>

            <TextBlock Grid.Column="14" Text="{Binding InstalledSummaryText}" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,6,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="420" ToolTip="{Binding InstalledSummaryText}"/>
          </Grid>

          <!-- Installed filter bar -->
          <Grid Grid.Row="1" Margin="4,10,4,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
              <TextBox Padding="30,7,8,7" Text="{Binding InstalledSearchText, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="🔍" FontSize="13" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              <TextBlock Text="Search mods or type @Author..." Margin="31,0,8,0"
                         Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding InstalledSearchText}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding InstalledSearchText}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>

            <Button Grid.Column="2" Style="{StaticResource DarkButton}" Content="Clear" MinWidth="84"
                    Command="{Binding ClearInstalledFiltersCommand}"
                    ToolTip="Clear the search text and all filter toggles"/>

            <TextBlock Grid.Column="4" Text="Sort" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{StaticResource TextSecondary}"/>
            <ComboBox Grid.Column="6" Width="190"
                      ItemsSource="{Binding InstalledSortModeOptions}"
                      SelectedItem="{Binding InstalledSortMode}"
                      ToolTip="How the installed list is ordered (column headers still sort on click)"/>

            <CheckBox Grid.Column="8" VerticalAlignment="Center" Content="Updates first"
                      IsChecked="{Binding UpdatesFirst}"
                      ToolTip="Mods with an available update float to the top of the list"/>
            <CheckBox Grid.Column="10" VerticalAlignment="Center" Content="Hide Disabled mods"
                      IsChecked="{Binding HideDisabledMods}"
                      ToolTip="Hide mods disabled with the .disabled folder suffix"/>
          </Grid>

          <!-- Installed list -->
          <Grid Grid.Row="2" Margin="0,6,0,0">
            <ListBox x:Name="InstalledList" ItemsSource="{Binding InstalledItems}"
                     Padding="4,6,4,10"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SizeChanged="OnInstalledListSizeChanged">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <wpf:VirtualizingWrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>

              <ListBox.ItemTemplate>
                <DataTemplate>
                  <!-- ============================ Installed mod card (unified with the browse grid: 3 columns, 220px, 135px thumbnail) ============================ -->
                  <Border Height="220" Width="{Binding DataContext.InstalledCardWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                          Margin="6" Padding="12" CornerRadius="8"
                          Background="{StaticResource BgCard}" BorderThickness="1"
                          Loaded="InstalledCard_Loaded">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                          </Trigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>

                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>

                      <!-- Thumbnail block: large 1:1 square, rounded, badges overlaid -->
                      <Grid Grid.Column="0" Width="135" Height="135" VerticalAlignment="Center">
                        <Border Background="{StaticResource BgSurface}" CornerRadius="6" ClipToBounds="True">
                          <TextBlock Text="{Binding Initial}" FontSize="42" FontWeight="Bold"
                                     Foreground="#3A4150" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <!-- Image with a null Source renders nothing, so the placeholder shows until loaded -->
                        <Image Source="{Binding Thumbnail}" Width="135" Height="135"
                               Stretch="UniformToFill" ClipToBounds="True"
                               RenderOptions.BitmapScalingMode="HighQuality">
                          <Image.Clip>
                            <RectangleGeometry Rect="0,0,135,135" RadiusX="6" RadiusY="6"/>
                          </Image.Clip>
                        </Image>

                        <!-- Top-left: green SPT-version pill -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="{StaticResource Green}" CornerRadius="6" Padding="6,2" Margin="3">
                          <TextBlock Text="{Binding SptBadgeText}" FontSize="9.5" FontWeight="SemiBold"
                                     Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="126"
                                     Visibility="{Binding HasSptBadge, Converter={StaticResource BoolToVisibility}}"/>
                        </Border>

                        <!-- Top-right: conflict / duplicate warning (click for details) -->
                        <Button VerticalAlignment="Top" HorizontalAlignment="Right"
                                Command="{Binding ShowConflictCommand}" ToolTip="{Binding ConflictToolTip}"
                                Margin="3" Padding="5,1" FontSize="10" FontWeight="Bold" Cursor="Hand"
                                Background="#3A2A10" Foreground="{StaticResource Warn}"
                                BorderBrush="{StaticResource Warn}" BorderThickness="1"
                                Content="{Binding ConflictBadgeText}"
                                Visibility="{Binding HasConflict, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Bottom-left: Fika Compatible overlay -->
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Background="#0E2A18" BorderBrush="{StaticResource Green}" BorderThickness="1"
                                CornerRadius="6" Padding="6,2" Margin="3">
                          <TextBlock Text="Fika Compatible" FontSize="9.5" FontWeight="SemiBold"
                                     Foreground="{StaticResource GreenHover}"
                                     Visibility="{Binding ShowFikaOverlay, Converter={StaticResource BoolToVisibility}}"/>
                        </Border>
                      </Grid>

                      <!-- Content area (right of the thumbnail) -->
                      <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0" Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding RelativePathText}"/>

                        <!-- Package id -->
                        <TextBlock Grid.Row="1" Text="{Binding PackageIdText}" FontFamily="Consolas" FontSize="10.5"
                                   Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageIdText}"/>

                        <!-- Author pill (orange) + gray pills (kind, category) -->
                        <WrapPanel Grid.Row="2" Margin="0,6,0,0" MaxHeight="48">
                          <Border Background="#3A2415" BorderBrush="{StaticResource Accent}"
                                  BorderThickness="1" CornerRadius="9" Padding="9,2" Margin="0,0,5,3">
                            <TextBlock Text="{Binding AuthorPillText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentHover}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="150" ToolTip="{Binding AuthorsText}"/>
                          </Border>
                          <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                                  BorderThickness="1" CornerRadius="9" Padding="9,2" Margin="0,0,5,3">
                            <TextBlock Text="{Binding PrimaryTagText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                          </Border>
                          <!-- Second kind pill: a consolidated card with BOTH a server and a client
                               component shows both ("Server Mod" + "Client Plugin"). -->
                          <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                                  BorderThickness="1" CornerRadius="9" Padding="9,2" Margin="0,0,5,3"
                                  Visibility="{Binding HasSecondaryKindTag, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SecondaryKindTagText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                          </Border>
                          <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                                  BorderThickness="1" CornerRadius="9" Padding="9,2" Margin="0,0,5,3"
                                  Visibility="{Binding HasSecondaryTag, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SecondaryTagText}" FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"/>
                          </Border>
                        </WrapPanel>

                        <!-- Metadata row -->
                        <TextBlock Grid.Row="3" Text="{Binding StatsText}" FontSize="11.5" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding VersionDetailText}"/>

                        <!-- Description: exactly 2 lines with word-ellipsis -->
                        <TextBlock Grid.Row="4" Text="{Binding TeaserText}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                   LineHeight="14" MaxHeight="28" TextTrimming="WordEllipsis" VerticalAlignment="Top"
                                   ToolTip="{Binding TeaserText}"/>

                        <!-- Action row -->
                        <Grid Grid.Row="5" Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0" Text="{Binding CardStatusText}" FontSize="11"
                                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                     Visibility="{Binding CardStatusText, Converter={StaticResource StringToVisibility}}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding CardStatusBrushKey}" Value="Warn">
                                    <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding CardStatusBrushKey}" Value="Green">
                                    <Setter Property="Foreground" Value="{StaticResource Green}"/>
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding CardStatusBrushKey}" Value="Danger">
                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>

                          <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button Style="{StaticResource DarkButton}" Content="Edit Configs" Height="28"
                                    MinWidth="92" Padding="8,0" Command="{Binding EditConfigsCommand}"
                                    ToolTip="Edit Configs — open this mod's .json / .jsonc / .cfg / .yaml files in the built-in editor"/>
                            <Button Style="{StaticResource AccentButton}" Content="⬆ Update" Height="28"
                                    MinWidth="80" Padding="8,0" Margin="6,0,0,0" Command="{Binding UpdateCommand}"
                                    Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{Binding VersionDetailText}"/>
                            <Button Height="28" MinWidth="82" Padding="8,0" Margin="6,0,0,0"
                                    Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                    ToolTip="Disabled mods are renamed with a “.disabled” suffix so SPT skips loading them">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DarkButton}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                      <Setter Property="Background" Value="{StaticResource Green}"/>
                                      <Setter Property="BorderBrush" Value="{StaticResource Green}"/>
                                      <Setter Property="Foreground" Value="White"/>
                                      <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                            </Button>
                            <Button Style="{StaticResource RedButton}" Content="Uninstall" Height="28"
                                    MinWidth="86" Padding="8,0" Margin="6,0,0,0" Command="{Binding UninstallCommand}"
                                    ToolTip="Permanently delete this mod from your SPT folder (asks for confirmation)"/>
                          </WrapPanel>
                        </Grid>
                      </Grid>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasInstalledResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
              <TextBlock Text="📦" FontSize="42" HorizontalAlignment="Center" Opacity="0.55"/>
              <TextBlock Text="{Binding InstalledEmptyText}" FontSize="14.5" Margin="0,10,0,0"
                         Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ============================================================ Settings -->
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4,12,4,4">
          <StackPanel MaxWidth="880" HorizontalAlignment="Left" Margin="10,0,10,18">

            <!-- ============ SPT folder configuration ============ -->
            <TextBlock Text="SPT Folder" FontSize="15" FontWeight="Bold" Margin="2,0,0,8"/>
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Single Player Tarkov root folder (contains BepInEx, user and EscapeFromTarkov.exe)"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding SptDirectory, UpdateSourceTrigger=LostFocus}"
                           FontFamily="Consolas" FontSize="12.5" Padding="8,6"
                           ToolTip="The SPT root all mods are installed into"/>
                  <Button Grid.Column="1" Content="Browse…" Command="{Binding SetDirectoryCommand}"
                          Style="{StaticResource AccentButton}" MinWidth="96" Margin="10,0,0,0"
                          ToolTip="Open a folder selection dialog"/>
                </Grid>

                <!-- Auto-detected version badge (read-only) -->
                <Border HorizontalAlignment="Left" Background="#0E2A18" BorderBrush="{StaticResource Green}"
                        BorderThickness="1" CornerRadius="9" Padding="12,4" Margin="0,12,0,0">
                  <TextBlock Text="{Binding SettingsSptVersionBadge}" FontSize="12.5" FontWeight="SemiBold"
                             Foreground="{StaticResource GreenHover}"/>
                </Border>
                <TextBlock Text="Version is parsed automatically from package.json, SPT.Server.exe / Aki.Server.exe version info, or the SPT core assemblies."
                           FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <!-- ============ Mod paths configuration ============ -->
            <TextBlock Text="Mod Paths" FontSize="15" FontWeight="Bold" Margin="2,20,0,8"/>
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14">
              <StackPanel>
                <TextBlock Text="Client mods subpath (relative to the SPT root)" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding SettingsClientModPath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="12.5" Padding="8,6" MaxWidth="420" HorizontalAlignment="Left"
                         ToolTip="Where client (BepInEx) mods are extracted — default: BepInEx/plugins"/>

                <TextBlock Text="Server mods subpath (relative to the SPT root)" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="0,12,0,6"/>
                <TextBox Text="{Binding SettingsServerModPath, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="12.5" Padding="8,6" MaxWidth="420" HorizontalAlignment="Left"
                         ToolTip="Where server mods are extracted — default: user/mods"/>

                <!-- Live preview -->
                <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,14,0,0" MaxWidth="720" HorizontalAlignment="Left">
                  <StackPanel>
                    <TextBlock Text="Final mod folder paths:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding SettingsPreviewClientPath}" FontFamily="Consolas" FontSize="12.5"
                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource GreenHover}"/>
                    <TextBlock Text="{Binding SettingsPreviewServerPath}" FontFamily="Consolas" FontSize="12.5"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource GreenHover}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <!-- ============ Bottom action bar ============ -->
            <StackPanel Orientation="Horizontal" Margin="2,20,0,0">
              <Button Style="{StaticResource GreenButton}" Content="💾  Save" MinWidth="120" Padding="12,8"
                      Command="{Binding SaveSettingsCommand}"
                      ToolTip="Persist the configured paths to settings.json and apply them"/>
              <Button Style="{StaticResource GhostButton}" Content="🗑  Clear Cache" MinWidth="120" Padding="12,8" Margin="10,0,0,0"
                      Command="{Binding ClearCacheCommand}"
                      ToolTip="Purge cached API data (in-memory + on-disk thumbnails)"/>
              <Button Style="{StaticResource GhostButton}" Content="🧹  Clear Temp Files" MinWidth="130" Padding="12,8" Margin="10,0,0,0"
                      Command="{Binding ClearTempFilesCommand}"
                      ToolTip="Delete leftover .zip / .rar / .7z archives and extraction artifacts from the temp folder"/>
              <Button Style="{StaticResource GhostButton}" Content="📄  Clear Log Files" MinWidth="130" Padding="12,8" Margin="10,0,0,0"
                      Command="{Binding ClearLogFilesCommand}"
                      ToolTip="Erase local app log files (crash.log)"/>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- ============================================================ Status bar -->
    <Border Grid.Row="3" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,1,0,0"
            Padding="14,9,14,9">
      <Grid>
        <!-- left: copyright + live status text -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Blacksite Mod Manager" FontSize="12"
                     Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusText}" Margin="18,0,0,0" FontSize="12.5" MaxWidth="430"
                     Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" ToolTip="{Binding StatusText}"/>
        </StackPanel>

        <!-- bottom-center: Installation Queue toggle button + live count badge (task 6.3) -->
        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenQueueWindowCommand}"
                Padding="12,5" MinWidth="220"
                ToolTip="Open / close the Installation Queue — live downloads, extraction and results (works from every tab)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Installation Queue" FontSize="12.5" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            <Border Background="{StaticResource Accent}" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding QueueBadgeVisible, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="{Binding QueueBadgeText}" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="White" HorizontalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Button>

        <!-- right: transfer speed + progress -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="{Binding SpeedText}" FontSize="12" FontFamily="Consolas"
                     Foreground="{StaticResource AccentHover}" VerticalAlignment="Center"
                     Visibility="{Binding SpeedText, Converter={StaticResource StringToVisibility}}"/>
          <ProgressBar Width="200" Margin="14,0,0,0" VerticalAlignment="Center"
                       Minimum="0" Maximum="100"
                       Value="{Binding ProgressPercent, Mode=OneWay}"
                       IsIndeterminate="{Binding IsProgressIndeterminate}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============================================================ Toast notifications (bottom-right) -->
    <ItemsControl Grid.Row="0" Grid.RowSpan="4" ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,18,66" IsHitTestVisible="False"
                  Focusable="False">
      <ItemsControl.Resources>
        <!-- toast card: starts invisible, fades in over 220 ms when loaded -->
        <Style x:Key="ToastCard" TargetType="Border">
          <Setter Property="Opacity" Value="0"/>
          <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Style.Triggers>
        </Style>
      </ItemsControl.Resources>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource ToastCard}" Background="{StaticResource BgCard}"
                  BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                  CornerRadius="10" Padding="14,10" Margin="0,0,0,10"
                  MinWidth="300" MaxWidth="400">
            <Border.Effect>
              <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                         Foreground="{StaticResource GreenHover}"/>
              <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"
                         Foreground="{StaticResource TextPrimary}"/>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
