<Window x:Class="Blacksite.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blacksite"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,0">
    <StackPanel Margin="22,20,22,18">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="IconText" Text="ℹ️" FontSize="22" VerticalAlignment="Top" Margin="0,0,12,0"/>
        <TextBlock x:Name="TitleText" Text="Title" FontSize="16" FontWeight="Bold"
                   TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="440"/>
      </StackPanel>

      <ScrollViewer Margin="34,12,0,0" MaxHeight="380" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText" Text="Message"
                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="13"/>
      </ScrollViewer>

      <StackPanel x:Name="ButtonsRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="YesButton" Style="{StaticResource AccentButton}" MinWidth="96" Margin="0,0,10,0"
                Content="Yes" Click="Yes_Click" Visibility="Collapsed"/>
        <Button x:Name="NoButton" MinWidth="96" Margin="0,0,10,0"
                Content="No" Click="No_Click" Visibility="Collapsed" IsCancel="True"/>
        <Button x:Name="OkButton" Style="{StaticResource AccentButton}" MinWidth="96"
                Content="OK" Click="Ok_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
