<Window x:Class="Blacksite.Views.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Configs"
        Width="980" Height="680" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Grid Margin="16,14,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
          <Run Text="Edit Configs — "/><Run Text="{Binding ModName, Mode=OneWay}" Foreground="{StaticResource AccentHover}"/>
        </TextBlock>
      </StackPanel>
      <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource GhostButton}"
              Padding="9,4" FontSize="13" ToolTip="Close" Command="{Binding CloseCommand}"/>
    </Grid>

    <!-- Body: sidebar + editor -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar: discovered config files -->
      <Border Grid.Column="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderSoft}"
              BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Config files" FontSize="11.5" FontWeight="SemiBold"
                     Foreground="{StaticResource TextMuted}" Margin="12,10,12,6"/>
          <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                   Background="Transparent" BorderThickness="0" Padding="4"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,3" ToolTip="{Binding FullPath}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0" Opacity="0.8"/>
                    <TextBlock Text="{Binding RelativePath}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimary}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding SizeText}" FontSize="10.5" Margin="23,1,0,0"
                             Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Main area: large scrollable editor -->
      <Border Grid.Column="2" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSoft}"
              BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
          <TextBox Text="{Binding FileText, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" AcceptsTab="True"
                   FontFamily="Consolas" FontSize="12.5" Padding="12,10"
                   BorderThickness="0" Background="Transparent"
                   Foreground="{StaticResource TextPrimary}"
                   HorizontalScrollBarVisibility="Auto"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap"
                   CaretBrush="{StaticResource Accent}"
                   IsReadOnly="{Binding IsLoading}"/>
          <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                     Visibility="{Binding HasNoFiles, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
      </Border>
    </Grid>

    <!-- Bottom bar -->
    <Grid Grid.Row="2" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding ActivePathText}" FontFamily="Consolas" FontSize="11"
                   Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" MaxWidth="430"
                   ToolTip="{Binding ActivePathText}"/>
        <TextBlock Text="{Binding DirtyText}" FontSize="11.5" Margin="14,0,0,0" VerticalAlignment="Center"
                   Foreground="{StaticResource Warn}" FontWeight="SemiBold"/>
      </StackPanel>

      <Button Grid.Column="1" Style="{StaticResource GreenButton}" Content="💾  Save Changes"
              MinWidth="130" Padding="12,8" Command="{Binding SaveCommand}"
              ToolTip="Write the edited text directly back to the file on disk"/>
      <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Close" MinWidth="96"
              Padding="12,8" Margin="10,0,0,0" Command="{Binding CloseCommand}" IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
