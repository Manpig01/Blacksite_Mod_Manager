<Window x:Class="Blacksite.Views.VersionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Blacksite.ViewModels"
        Title="Install version"
        Width="720" Height="640" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- pill badge: small rounded label -->
    <Style x:Key="PillText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- version card -->
    <DataTemplate x:Key="VersionCardTemplate" DataType="{x:Type vm:VersionCardViewModel}">
      <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSoft}"
              BorderThickness="1" CornerRadius="10" Padding="16,12,16,14" Margin="0,0,0,10">
        <StackPanel>
          <!-- header: version + badges + install -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GreenButton}" MinWidth="96" Margin="14,0,0,0"
                        VerticalAlignment="Top"
                        Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}"
                        ToolTip="Queue this exact release for installation"/>
                <StackPanel>
                  <TextBlock Text="{Binding VersionLabel}" FontSize="19" FontWeight="Bold"
                             Foreground="{StaticResource TextPrimary}"/>
                  <TextBlock Text="{Binding SizeText}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                             Margin="1,2,0,0"/>
                </StackPanel>
              </DockPanel>

              <!-- metadata pills -->
              <WrapPanel Margin="0,10,0,0">
                <Border Background="#1D4ED8" CornerRadius="9" Padding="10,3" Margin="0,0,6,6"
                        Visibility="{Binding IsLatest, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Style="{StaticResource PillText}" Text="Latest" Foreground="#FFFFFF"/>
                </Border>

                <Border Background="#0E2A18" BorderBrush="{StaticResource Green}" BorderThickness="1"
                        CornerRadius="9" Padding="10,3" Margin="0,0,6,6"
                        Visibility="{Binding FikaCompatible, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Style="{StaticResource PillText}" Text="Fika Compatible" Foreground="{StaticResource GreenHover}"/>
                </Border>

                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1" CornerRadius="9" Padding="10,3" Margin="0,0,6,6"
                        Visibility="{Binding FikaCompatible, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                  <TextBlock Style="{StaticResource PillText}" Text="Fika unknown" Foreground="{StaticResource TextSecondary}"/>
                </Border>

                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1" CornerRadius="9" Padding="10,3" Margin="0,0,6,6">
                  <TextBlock Style="{StaticResource PillText}" Text="{Binding DownloadsText}"
                             Foreground="{StaticResource TextSecondary}"/>
                </Border>

                <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1" CornerRadius="9" Padding="10,3" Margin="0,0,6,6">
                  <TextBlock Style="{StaticResource PillText}" Text="{Binding DateText}"
                             Foreground="{StaticResource TextSecondary}"/>
                </Border>

                <Border Background="#0E2A18" BorderBrush="{StaticResource Green}" BorderThickness="1"
                        CornerRadius="9" Padding="10,3" Margin="0,0,6,6">
                  <TextBlock Style="{StaticResource PillText}" Text="{Binding SptText}"
                             Foreground="{StaticResource GreenHover}"/>
                </Border>
              </WrapPanel>
            </StackPanel>
          </Grid>

          <!-- changelog expander -->
          <StackPanel Margin="0,10,0,0" Visibility="{Binding HasChangelog, Converter={StaticResource BoolToVisibility}}">
            <ToggleButton Content="{Binding ChangelogToggleText}" IsChecked="{Binding IsExpanded}"
                          FontSize="12.5" Cursor="Hand" Foreground="{StaticResource AccentHover}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <ContentPresenter Margin="0" RecognizesAccessKey="True"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0"
                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"
                    MaxHeight="280">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding ChangelogText}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{StaticResource TextSecondary}" LineHeight="19"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- header bar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BgSurface}"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1" Padding="18,12">
      <Grid>
        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold">
          <Run Text="Install "/><Run Text="{Binding ModTitle, Mode=OneWay}" Foreground="{StaticResource AccentHover}"/>
        </TextBlock>
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="✕"
                Style="{StaticResource GhostButton}" Padding="9,4" FontSize="13"
                ToolTip="Close" Click="OnCloseClick"/>
      </Grid>
    </Border>

    <!-- body -->
    <Grid Margin="0,14,0,0">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="🐉" FontSize="34" HorizontalAlignment="Center" Opacity="0.6"/>
        <TextBlock Text="{Binding LoadingText}" HorizontalAlignment="Center" Margin="0,10,0,0"
                   Foreground="{StaticResource TextSecondary}"/>
      </StackPanel>

      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}">
        <TextBlock Text="{Binding ErrorText}" HorizontalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{StaticResource Danger}" MaxWidth="480"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,4,18,16"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
          <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="2,0,0,8"/>
          <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource VersionCardTemplate}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
