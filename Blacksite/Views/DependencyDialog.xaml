<Window x:Class="Blacksite.Views.DependencyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dependencies required"
        Width="600" SizeToContent="Height" MinWidth="500" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindow}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        ShowActivated="True">

  <Window.Resources>
    <!-- one bulleted dependency line -->
    <DataTemplate x:Key="BulletRow">
      <TextBlock FontSize="13.5" Margin="0,0,0,6">
        <Run Text="• " Foreground="{StaticResource AccentHover}" FontWeight="Bold"/>
        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
        <Run Text="  →  v" Foreground="{StaticResource Green}"/>
        <Run Text="{Binding ResolvedVersion, Mode=OneWay}" Foreground="{StaticResource Green}"/>
      </TextBlock>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="22,20,22,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,10">
      <TextBlock Text="Dependencies required" FontSize="17" FontWeight="Bold"/>
      <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13.5">
        <Run Text="“"/><Run Text="{Binding ModName, Mode=OneWay}" Foreground="{StaticResource AccentHover}" FontWeight="SemiBold"/><Run Text="” needs "/>
        <Run Text="{Binding MissingCount, Mode=OneWay}" FontWeight="Bold"/><Run Text=" dependencies:"/>
      </TextBlock>
    </StackPanel>

    <!-- Bulleted dependency list -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280" Margin="4,0,4,0">
      <StackPanel>
        <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource BulletRow}"/>

        <!-- real API extras, only when present -->
        <ItemsControl ItemsSource="{Binding Unresolved}" Margin="0,4,0,0"
                      Visibility="{Binding Unresolved, Converter={StaticResource CountToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="13.5" Margin="0,0,0,6">
                <Run Text="• " Foreground="{StaticResource Warn}" FontWeight="Bold"/>
                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="  (could not auto-resolve)" Foreground="{StaticResource Warn}"/>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Conflicts}"
                      Margin="0,4,0,0"
                      Visibility="{Binding Conflicts, Converter={StaticResource CountToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock FontSize="13.5" Margin="0,0,0,6">
                <Run Text="• " Foreground="{StaticResource Danger}" FontWeight="Bold"/>
                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text="  (conflict)" Foreground="{StaticResource Danger}"/>
              </TextBlock>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Subtext warning -->
    <TextBlock Grid.Row="2" Margin="4,12,4,0" FontStyle="Italic" FontSize="12.5"
               Foreground="{StaticResource TextMuted}"
               Text="Choose your option wisely, there may be dragons here..."/>

    <!-- Action buttons -->
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Button x:Name="InstallAllButton" Grid.Column="0" Style="{StaticResource GreenButton}" Padding="10,9" Margin="0,0,8,0"
              Content="Install mod + dependencies" Click="InstallAll_Click"
              ToolTip="Queue every missing dependency first, then the mod itself"/>
      <Button Grid.Column="1" Style="{StaticResource DangerButton}" Padding="10,9" Margin="0,0,8,0"
              Content="Install without dependencies" Click="InstallModOnly_Click"
              ToolTip="Queue only the mod — you handle its dependencies yourself"/>
      <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="16,9" MinWidth="96"
              Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
